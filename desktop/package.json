{
  "name": "noisy-coding-companion",
  "version": "2.17.0",
  "private": true,
  "description": "The noisy-coding companion widget, always on top",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "NOISY_COMPANION_URL=http://localhost:5173/companion?transparent=1 electron .",
    "dist": "npm run build:ui && npm run build:daemon && electron-builder --mac --dir",
    "dmg": "electron-builder --mac",
    "local": "NOISY_MODE=local electron .",
    "build:daemon": "cd .. && .venv/bin/pyinstaller desktop/daemon.spec --distpath desktop/build/daemon --noconfirm --log-level WARN",
    "dist:dev": "electron-builder --mac --dir -c.extraMetadata.noisyMode=local -c.productName=\"Noisy Coding Dev\" -c.appId=pl.noisy.coding.companion.dev -c.directories.output=dist-dev -c.mac.icon=build/icon-dev.icns",
    "build:ui": "cd ../dashboard && npm run build"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "productName": "Noisy Coding",
  "build": {
    "appId": "pl.noisy.coding.companion",
    "productName": "Noisy Coding",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "build/tray*.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/daemon",
        "to": "daemon"
      }
    ]
  }
}