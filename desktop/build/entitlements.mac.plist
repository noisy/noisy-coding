<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime entitlements for the MAIN app (#95). V8 needs JIT;
       the microphone entitlement lets the app ask for audio input. Library
       validation stays ON: everything we load is signed with our Team ID
       (sounddevice ships its own libportaudio, re-signed at build time) and
       Apple's system libraries always pass; an unsigned PortAudio in
       /usr/local/lib must be refused, not loaded. Helpers and the engine
       use entitlements.inherit.plist. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
